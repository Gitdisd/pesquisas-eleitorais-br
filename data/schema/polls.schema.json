{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pesquisas-eleitorais-br.local/schemas/polls.schema.json",
  "title": "Brazilian election polls (canonical array)",
  "description": "Bare JSON array of verified national presidential poll records. Frontend loads `${import.meta.env.BASE_URL}data/polls.json` from Vite publicDir (public/data/polls.json); data/polls.json is the SoT mirror. Meta lives in data/meta.json (mirrored to public/data/meta.json for `${BASE_URL}data/meta.json`); not wrapped here.",
  "type": "array",
  "items": {
    "$ref": "#/$defs/poll"
  },
  "minItems": 0,
  "$defs": {
    "dateYMD": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
      "description": "Calendar date as YYYY-MM-DD"
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "party_optional",
        "pct"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "description": "Candidate display name (or aggregate bucket)"
        },
        "party_optional": {
          "type": [
            "string",
            "null"
          ],
          "description": "Party acronym when known; null for aggregates"
        },
        "pct": {
          "type": "number",
          "description": "Voting intention percentage as published"
        }
      }
    },
    "poll": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "institute",
        "fieldwork_start",
        "fieldwork_end",
        "published_date",
        "scenario",
        "candidates",
        "n",
        "margin_of_error",
        "source_url",
        "methodology_note",
        "verified"
      ],
      "properties": {
        "institute": {
          "type": "string",
          "minLength": 1
        },
        "fieldwork_start": {
          "$ref": "#/$defs/dateYMD"
        },
        "fieldwork_end": {
          "$ref": "#/$defs/dateYMD"
        },
        "published_date": {
          "$ref": "#/$defs/dateYMD"
        },
        "scenario": {
          "type": "string",
          "minLength": 1
        },
        "candidates": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/candidate"
          }
        },
        "n": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "margin_of_error": {
          "type": "string",
          "minLength": 1
        },
        "source_url": {
          "type": "string",
          "format": "uri",
          "minLength": 1
        },
        "methodology_note": {
          "type": "string"
        },
        "verified": {
          "type": "boolean"
        },
        "flag": {
          "type": "string"
        }
      }
    }
  }
}
