{
  "name": "pesquisas-eleitorais-br",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "typecheck": "npx --yes -p typescript@5.9.3 tsc --noEmit -p tsconfig.json",
    "update-polls": "node scripts/update-polls.mjs",
    "discover-polls": "node scripts/discover-polls.mjs",
    "poll-pipeline": "node scripts/run-poll-pipeline-v4.mjs",
    "test": "node --test test/*.test.mjs",
    "build:rust": "wasm-pack build rust/polling-core --target web --out-dir ../../public/wasm/polling-core --release",
    "test:python": "python -m pytest python/tests -q",
    "test:rust": "cargo test --manifest-path rust/polling-core/Cargo.toml",
    "backtest:advanced": "npx --yes tsx@4.23.15 scripts/run_advanced_backtest.mjs data/polls.json --output advanced-backtest-report.json"
  }
}
